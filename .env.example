# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=shop_db
DB_USER=shop_user
DB_PASSWORD=strong_password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Review media limits
REVIEW_MAX_MEDIA_FILES=5
REVIEW_MAX_IMAGE_SIZE_MB=10
REVIEW_MAX_VIDEO_SIZE_MB=50

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@fashionshop.kz

# S3 / MinIO media storage
USE_S3=True
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=shop-media
MINIO_PUBLIC_DOMAIN=localhost:9000/shop-media
MINIO_PUBLIC_PROTOCOL=http:
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# External S3-compatible storage (optional override)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_URL_PROTOCOL=https:
AWS_S3_ADDRESSING_STYLE=path
AWS_QUERYSTRING_AUTH=False

# FreedomPay
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET_KEY=
FREEDOMPAY_API_URL=https://api.freedompay.kz
# 1 — тестовый режим, 0 — боевой
FREEDOMPAY_TESTING_MODE=1
# Публичный URL бэкенда (должен быть доступен FreedomPay для result_url callback)
BACKEND_PUBLIC_URL=http://localhost:8000
# URL фронтенда для success_url / fail_url
FRONTEND_URL=http://localhost:3000
